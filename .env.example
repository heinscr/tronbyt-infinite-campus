# Copy to .env and fill in locally. Never commit the completed file.
# Base URL ends in /campus/; app name is the district slug before .jsp.
IC_CAMPUS_URL=https://school.example/campus/
IC_APP_NAME=your-district
IC_TIMEZONE=America/New_York
IC_USERNAME=''
IC_PASSWORD=''

# Use your own Tronbyt server, device ID, login, and existing device API key.
TRONBYT_SERVER_URL=http://localhost:8000
TRONBYT_DEVICE_ID=''
TRONBYT_USERNAME=''
TRONBYT_PASSWORD=''
TRONBYT_API_KEY=''
